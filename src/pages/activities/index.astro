---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ActivityFilter from '../../components/ActivityFilter.svelte';

const activities = (await getCollection('activities')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const activityItems = await Promise.all(
  activities.map(async (activity) => {
    const thumbnail = await getImage({ src: activity.data.thumnail });
    return {
      title: activity.data.title,
      url: `/activities/${activity.id}/`,
      date: activity.data.date.toLocaleDateString('ja-JP'),
      thumnail: thumbnail.src,
      tags: activity.data.tags
    };
  })
);
---

<Layout title="kzgrm" description="kzgrm">
  <h1>Activities</h1>
  <p>今までの活動だよ〜〜〜</p>
  <ActivityFilter client:load activities={activityItems} />
</Layout>
