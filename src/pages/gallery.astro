---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/gallery/*.{svg,png,jpg,jpeg,webp,avif}',
  { eager: true }
);

const photos = Object.values(imageModules)
  .map((m) => m.default)
  .map((p) => ({ p, sort: Math.random() }))
  .sort((a, b) => a.sort - b.sort)
  .map(({ p }) => p);
---

<Layout title="kzgrm gallery" description="kzgrm" wide={true}>
  <h1>Gallery</h1>
  <div class="masonry">
    {photos.map((photo) => (
      <div class="masonry-item">
        <Image src={photo} alt="" loading="lazy" />
      </div>
    ))}
  </div>
</Layout>

<style>
  h1 {
    margin-bottom: 1.5rem;
  }

  .masonry {
    columns: 4 220px;
    column-gap: 0.75rem;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.4rem;
  }

  @media (max-width: 600px) {
    .masonry {
      columns: 2 160px;
    }
  }
</style>
